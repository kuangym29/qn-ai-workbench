# MySQL 8.4 测试环境变量样例 —— QN AI 内容工作台
#
# 用途：为 DuplicateReview（D11）补做真实 MySQL 8.4 的 Release Gate 验证。
#
# 用法：
#   cp .env.mysql-testing.example .env.mysql-testing
#   # 如需改密码，改这里，然后同步 docker-compose.mysql-test.yml
#   php artisan migrate --env=mysql-testing
#   php artisan test --env=mysql-testing
#
# 安全约定：
#   - 下面全部是**本地一次性测试用值**，与任何真实凭据无关
#   - `.env.mysql-testing` 已被 .gitignore 忽略，真实密码绝不提交
#   - 库名以 _test 结尾，账号为 qn_test，**不使用 root 作为 Laravel 测试用户**
#   - 不要把生产库名或生产密码填进来

APP_ENV=testing
APP_DEBUG=true
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3399
DB_DATABASE=qn_workbench_test
DB_USERNAME=qn_test
DB_PASSWORD=qn_test_pw

# 显式声明，避免依赖 config/database.php 的默认值
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# 测试期用轻量驱动，避免写 Redis / 队列
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
