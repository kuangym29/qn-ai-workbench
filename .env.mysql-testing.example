# MySQL 8.4 测试环境变量样例 —— QN AI 内容工作台
#
# 用途：为 DuplicateReview（D11）补做真实 MySQL 8.4 的 Release Gate 验证。
#
# 用法：
#   cp .env.mysql-testing.example .env.mysql-testing
#   php artisan key:generate --env=mysql-testing
#   scripts/test-mysql.sh all
#
# 如果要改任何一项，请同步修改这三处，否则 Gate 会在安全校验处直接中止：
#   - docker-compose.mysql-test.yml（容器侧库名 / 账号 / 端口）
#   - phpunit.mysql84.xml（测试进程侧的 <env> 锁定值）
#   - scripts/test-mysql.sh 顶部的常量
#
# 安全约定：
#   - 下面全部是**本地一次性测试用值**，与任何真实凭据无关
#   - `.env.mysql-testing` 已被 .gitignore 忽略，真实密码绝不提交
#   - 库名以 _test 结尾，账号为 qn_test，**不使用 root 作为 Laravel 测试用户**
#   - 端口固定 3399，只连 127.0.0.1，避开本机既有的 3306 / 3307
#   - **不要设置 DB_URL**：它会整体覆盖下面的 host/port/database/username/password，
#     使 scripts/test-mysql.sh 的逐项安全校验失效。脚本检测到非空 DB_URL 会拒绝运行。

APP_ENV=testing
APP_DEBUG=true
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3399
DB_DATABASE=qn_workbench_test
DB_USERNAME=qn_test
DB_PASSWORD=qn_test_pw
# 留空。留空与删除该行都安全，Gate 两者都接受。
# 但**不要填任何非空值**：Laravel 的 config/database.php 读 DB_URL，一旦有值，
# 它会优先于下面所有逐项配置，安全校验就形同虚设。脚本与 bootstrap 都会拒绝。
DB_URL=

# 显式声明，避免依赖 config/database.php 的默认值
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# 测试期用轻量驱动，避免写 Redis / 队列
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
